@{
    string theme = Context.Request.Cookies["UserTheme"] ?? "White";
    string bgClass = theme == "Black" ? "bg-dark text-white" : "bg-light text-dark";
    string cardClass = theme == "Black" ? "bg-secondary text-white" : "bg-white text-dark";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - App</title>
    <!-- Bootstrap 5 CDN Template -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body.theme-dark {
            background-color: #121212 !important;
            color: #ffffff !important;
        }

            body.theme-dark .navbar {
                background-color: #1f1f1f !important;
            }

            body.theme-dark .card {
                background-color: #1e1e1e !important;
                color: #ffffff !important;
                border-color: #333;
            }

            body.theme-dark .table {
                color: #ffffff !important;
            }
    </style>
</head>
<body class="@(theme == "Black" ? "theme-dark" : "theme-light")">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MVC Final App</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Employee" asp-action="Index">Employees</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Theme" asp-action="Index">Theme Options</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">Products (Session)</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>