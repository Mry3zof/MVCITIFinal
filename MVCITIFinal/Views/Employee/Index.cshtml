@model IEnumerable<ProjectName.DAL.Entities.Employee>

<h2>Employee List</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Create New Employee</a>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Age</th>
            <th>Salary</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@item.ImagePath" width="50" height="50" class="rounded-circle" style="object-fit: cover;" />
                </td>
                <td>@item.Name</td>
                <td>@item.Age</td>
                <td>@item.Salary</td>
                <td>
                    <a asp-action="SaveToSession" asp-route-id="@item.Id" class="btn btn-info btn-sm">Add to Session</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>